{
  "extends": "@hunty/config/tsconfig/base.json",
  "compilerOptions": {
    "outDir": "dist",
    "paths": {
      "@hunty/types": ["../types/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": [
    "node_modules",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/__tests__/**/*"
  ]
}

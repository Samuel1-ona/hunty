{
  "name": "@hunty/config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared ESLint, TypeScript, and Tailwind configurations for the Hunty monorepo",
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/validate-exports.mjs"
  },
  "exports": {
    "./eslint/base.mjs": "./eslint/base.mjs",
    "./eslint/next.mjs": "./eslint/next.mjs",
    "./eslint/react-native.mjs": "./eslint/react-native.mjs",
    "./tsconfig/base.json": "./tsconfig/base.json",
    "./tsconfig/nextjs.json": "./tsconfig/nextjs.json",
    "./tsconfig/react-native.json": "./tsconfig/react-native.json",
    "./tailwind": "./tailwind/index.js"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@next/eslint-plugin-next": "15.3.4",
    "eslint": "^9",
    "eslint-config-next": "15.3.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-storybook": "^10.4.6",
    "typescript": "^5"
  }
}

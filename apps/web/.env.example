# ============================================================================
# Hunty Environment Configuration Example
# ============================================================================
# Copy this file to .env.local and update with your actual values for local development.
# Never commit .env.local to version control - it should contain sensitive keys.
#
# Quick Start:
#   1. Copy this file: cp .env.example .env.local
#   2. Update the values marked as REQUIRED with your actual credentials
#   3. Optional values can be left as-is for basic development
#
# For detailed setup instructions, see DEVELOPMENT.md
# ============================================================================

# ============================================================================
# ENVIRONMENT CONFIGURATION
# ============================================================================
# Determines which environment configuration to use
# Options: development | staging | production
NEXT_PUBLIC_ENVIRONMENT=development

# Node environment (automatically set by Next.js in most cases)
NODE_ENV=development

# Base URL where your application is hosted
# Local: http://localhost:3000
# Production: https://hunty.app
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ============================================================================
# STELLAR / SOROBAN BLOCKCHAIN CONFIGURATION
# ============================================================================
# Soroban RPC endpoint for interacting with the Stellar blockchain
# Testnet: https://soroban-testnet.stellar.org
# Mainnet: https://soroban-mainnet.stellar.org
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Optional: Fallback RPC URL if primary is down
# NEXT_PUBLIC_SOROBAN_FALLBACK_RPC_URL=https://soroban-testnet-backup.stellar.org

# Network passphrase for Stellar transactions
# Testnet: Test SDF Network ; September 2015
# Mainnet: Public Global Stellar Network ; September 2015
NEXT_PUBLIC_SOROBAN_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Network type: testnet or mainnet
NEXT_PUBLIC_SOROBAN_NETWORK_TYPE=testnet

# Performance tuning for Soroban RPC calls
# Debounce time in milliseconds for batching requests (default: 50)
# NEXT_PUBLIC_SOROBAN_DEBOUNCE_MS=50

# Cache time-to-live for read operations in milliseconds (default: 30000)
# NEXT_PUBLIC_SOROBAN_READ_TTL_MS=30000

# ============================================================================
# SMART CONTRACT ADDRESSES
# ============================================================================
# REQUIRED: Deploy your Soroban contracts and add their addresses here
# Leave empty for local development without blockchain integration

# Main Hunty contract address
NEXT_PUBLIC_HUNTY_CORE_ADDRESS=

# Reward manager contract address
NEXT_PUBLIC_REWARD_MANAGER_ADDRESS=

# NFT reward contract address
NEXT_PUBLIC_NFT_REWARD_ADDRESS=

# ============================================================================
# API CONFIGURATION
# ============================================================================
# Internal API endpoint (usually the Next.js API routes)
# Horizon endpoint used for wallet balance lookups.
# Optional — defaults to the Horizon matching NEXT_PUBLIC_SOROBAN_NETWORK_TYPE
# (https://horizon-testnet.stellar.org / https://horizon.stellar.org).
# Set this to point at a private or self-hosted Horizon instance.
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# API endpoints
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# GraphQL endpoint for indexer queries
# Local: http://localhost:4000/graphql
# Production: https://indexer.hunty.app/graphql
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:4000/graphql

# Optional: Torii indexer URL for fastest player queries
# NEXT_PUBLIC_TORII_INDEXER_URL=https://torii.hunty.app

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
# Docker default: postgresql://hunty:hunty@localhost:5432/hunty_dev
DATABASE_URL=postgresql://user:password@localhost:5432/hunty_dev

# Database connection pool settings (optional)
# DB_POOL_MIN=2
# DB_POOL_MAX=10
# DB_POOL_IDLE_TIMEOUT_MS=30000

# Slow query logging threshold in milliseconds (default: 75)
# SLOW_QUERY_THRESHOLD_MS=75

# ============================================================================
# IPFS / FILE STORAGE (PINATA)
# ============================================================================
# REQUIRED for file uploads: Get your JWT from https://pinata.cloud
# Used server-side via /api/ipfs proxy to keep credentials secure
PINATA_JWT=your_pinata_jwt_token_here

# Optional: Custom Pinata gateway domain (e.g., "mygateway.mypinata.cloud")
# If not set, uses default public IPFS gateways
# NEXT_PUBLIC_PINATA_GATEWAY=

# ============================================================================
# EMAIL SERVICE (RESEND)
# ============================================================================
# REQUIRED for email features: Get your API key from https://resend.com
# Used for notifications, alerts, and transactional emails
RESEND_API_KEY=your_resend_api_key_here

# ============================================================================
# PAYMASTER SERVICE (FEE ABSTRACTION)
# ============================================================================
# REQUIRED: Secret seed for the Stellar keypair that signs fee-bump transactions.
# Generate with:
#   node -e "const {Keypair}=require('@stellar/stellar-sdk'); const kp=Keypair.random(); console.log('Secret:', kp.secret()); console.log('Public:', kp.publicKey())"
# Fund the account on testnet: https://laboratory.stellar.org/#account-creator?network=testnet
# On mainnet, send XLM from an exchange or another wallet.
PAYMASTER_SECRET=

# Public G-address of the paymaster keypair (used by the client to show status)
NEXT_PUBLIC_PAYMASTER_PUBLIC_KEY=

# ============================================================================
# WALLET INTEGRATION
# ============================================================================
# WalletConnect Project ID
# Get yours at https://cloud.walletconnect.com/
# REQUIRED for WalletConnect wallet support
NEXT_PUBLIC_WC_PROJECT_ID=

# ============================================================================
# MONITORING & ANALYTICS
# ============================================================================
# Monitoring system (enabled by default, set to "false" to disable)
# MONITORING_ENABLED=true

# ----------------------------------------------------------------------------
# Error tracking (Sentry)
# ----------------------------------------------------------------------------
# NEXT_PUBLIC_SENTRY_DSN  — Public DSN, safe to commit once you have a project.
#   1. Create a project at https://sentry.io
#   2. Copy the DSN from Settings → Projects → <project> → Client Keys (DSN)
#   3. Set it here (and in your hosting platform environment variables)
# NEXT_PUBLIC_SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project-id>

# SENTRY_AUTH_TOKEN  — Server-side only, NEVER commit.
#   Required to upload source maps so stack traces in Sentry are readable.
#   1. Go to https://sentry.io/settings/account/api/auth-tokens/
#   2. Create a token with project:releases and org:read scopes
#   3. Add to your CI as a secret (SENTRY_AUTH_TOKEN) and to .env.local locally
# SENTRY_AUTH_TOKEN=

# SENTRY_ORG  — Your Sentry organisation slug (visible in the Sentry URL).
# SENTRY_ORG=hunty

# SENTRY_PROJECT  — Your Sentry project slug.
# SENTRY_PROJECT=hunty-web

# ADMIN_API_SECRET  — Bearer token that protects the /api/admin/* routes.
#   Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   Must be provided to callers via: Authorization: Bearer <secret>
# ADMIN_API_SECRET=

# Application version for monitoring/tracking
# NEXT_PUBLIC_APP_VERSION=0.1.0

# Web Vitals endpoint for performance monitoring
# WEB_VITALS_ENDPOINT=
# WEB_VITALS_SAMPLE_RATE=0.1

# Hunt view analytics
# Optional external endpoint to forward anonymized analytics
# HUNT_VIEW_ANALYTICS_ENDPOINT=
# HUNT_VIEW_ANALYTICS_KEY=
# HUNT_VIEW_ANALYTICS_SECRET=hunty-analytics-secret

# ============================================================================
# ALERT CHANNELS
# ============================================================================
# Email alerts for system monitoring
# ALERT_EMAIL_ENABLED=false
# ALERT_EMAIL_TO=admin@hunty.app
# ALERT_EMAIL_FROM=monitoring@hunty.app

# Slack webhook for alerts
# ALERT_SLACK_ENABLED=false
# ALERT_SLACK_WEBHOOK_URL=

# Discord webhook for alerts
# ALERT_DISCORD_ENABLED=false
# ALERT_DISCORD_WEBHOOK_URL=

# ============================================================================
# SECURITY
# ============================================================================
# Content Security Policy reporting mode
# true = report violations without blocking (recommended for development/staging)
# false = enforce policy and block violations (recommended for production)
CSP_REPORT_ONLY=true

# Web Push (VAPID) — generate with: node -e "const wp=require('web-push'); console.log(JSON.stringify(wp.generateVAPIDKeys()))"
# The public key is exposed to the browser; the private key must remain server-side only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:admin@hunty.app
# Optional shared secret that callers must pass as "Authorization: Bearer <secret>" to /api/push/send
PUSH_API_SECRET=your_push_api_secret_here

# Deep Linking: Apple Universal Links
# ============================================================================
# MOBILE APP CONFIGURATION (EXPO)
# ============================================================================
# EAS (Expo Application Services) project ID
# Get from https://expo.dev after creating your project
# EXPO_PUBLIC_EAS_PROJECT_ID=

# Expo update URL for OTA updates
# EXPO_UPDATE_URL=https://u.expo.dev/YOUR_EAS_PROJECT_ID

# API base URLs for different mobile environments
# EXPO_PUBLIC_API_BASE_URL_DEVELOPMENT=https://dev-api.hunty.com
# EXPO_PUBLIC_API_BASE_URL_PREVIEW=https://staging-api.hunty.com
# EXPO_PUBLIC_API_BASE_URL_PRODUCTION=https://api.hunty.com

# Mobile app environment (development | preview | production)
# APP_ENV=development

# ============================================================================
# DEEP LINKING (MOBILE)
# ============================================================================
# Apple Universal Links configuration
# Your 10-character Apple Team ID (find at developer.apple.com)
APPLE_TEAM_ID=

# iOS bundle ID — must match the production App Store bundle ID
IOS_BUNDLE_ID=com.yourorg.hunty

# Android App Links configuration
# Comma-separated SHA-256 certificate fingerprints from your Android keystore
ANDROID_SHA256_CERT_FINGERPRINTS=

# Android package name — must match the Google Play Store package name
ANDROID_PACKAGE_NAME=com.yourorg.hunty

# Rate Limiting (all optional, see lib/config/constants.ts for defaults)
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_READ_IP=100
# RATE_LIMIT_WRITE_IP=30
# RATE_LIMIT_READ_WALLET=200
# RATE_LIMIT_WRITE_WALLET=50
# RATE_LIMIT_ADMIN_IP=20

# Upstash Redis (required for distributed rate limiting on serverless/Vercel)
# Get free tier at https://console.upstash.com/redis
# UPSTASH_REDIS_REST_URL=https://us1-example.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token_here

# Feature Flags
# Feature flags enable progressive rollout of new functionality.
# Each flag corresponds to a typed definition in lib/config/feature-flags/.
# Override flags at runtime via the feature flag store or API.
NEXT_PUBLIC_ENABLE_STAGING_BANNER=false
# NEXT_PUBLIC_FEATURE_NFT_MARKETPLACE=false
# NEXT_PUBLIC_FEATURE_HUNT_CHAT=false
# NEXT_PUBLIC_FEATURE_SEASONAL=false
# NEXT_PUBLIC_FEATURE_DRAG_DROP=false
# NEXT_PUBLIC_FEATURE_ADVANCED_REWARDS=false
# NEXT_PUBLIC_FEATURE_GAME_MODES=false
# NEXT_PUBLIC_FEATURE_COLLABORATIVE_HUNTS=false
# ============================================================================
# TESTING CONFIGURATION
# ============================================================================
# Playwright E2E tests
# PLAYWRIGHT_BASE_URL=http://localhost:3000
# SMOKE_BASE_URL=
# DEPLOYMENT_URL=

# Optional: Path to wallet extension for E2E testing
# WALLET_EXTENSION_PATH=/path/to/freighter-extension

# CI environment detection (automatically set by GitHub Actions, etc.)
# CI=true

# ============================================================================
# FEATURE FLAGS
# ============================================================================
# Show staging environment banner

# ============================================================================
# NOTES
# ============================================================================
# - Variables prefixed with NEXT_PUBLIC_ are exposed to the browser
# - Server-side variables (without NEXT_PUBLIC_) remain private
# - Restart your dev server after changing environment variables
# - For production deployment, set these in your hosting platform (Vercel, etc.)
# ============================================================================

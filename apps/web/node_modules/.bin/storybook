#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/workspaces/hunty/node_modules/.pnpm/storybook@10.5.4_@types+react@19.1.17_prettier@3.5.3_react@19.2.0/node_modules/storybook/node_modules:/workspaces/hunty/node_modules/.pnpm/storybook@10.5.4_@types+react@19.1.17_prettier@3.5.3_react@19.2.0/node_modules:/workspaces/hunty/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/workspaces/hunty/node_modules/.pnpm/storybook@10.5.4_@types+react@19.1.17_prettier@3.5.3_react@19.2.0/node_modules/storybook/node_modules:/workspaces/hunty/node_modules/.pnpm/storybook@10.5.4_@types+react@19.1.17_prettier@3.5.3_react@19.2.0/node_modules:/workspaces/hunty/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../storybook/dist/bin/dispatcher.js" "$@"
else
  exec node  "$basedir/../storybook/dist/bin/dispatcher.js" "$@"
fi

{
  "name": "hunty",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "description": "Cross-platform scavenger hunt dApp using Next.js, Expo, IPFS, and Stellar/Soroban.",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "type-check": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:mutation": "turbo run test:mutation",
    "e2e": "turbo run e2e",
    "smoke": "turbo run smoke",
    "test:e2e": "pnpm test:e2e --workspace @hunty/web",
    "analyze": "pnpm analyze --workspace @hunty/web",
    "bundle:check": "turbo run bundle:check",
    "perf:budget": "turbo run perf:budget",
    "storybook": "pnpm storybook --workspace @hunty/web",
    "build-storybook": "pnpm build-storybook --workspace @hunty/web",
    "clean": "turbo run clean",
    "prepare": "husky"
  },
  "lint-staged": {
    "apps/mobile/**/*.{js,jsx,ts,tsx,json,md}": [
      "npx prettier --write"
    ],
    "apps/web/**/*.{ts,tsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "packages/**/*.{ts,tsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{js,mjs,cjs}": [
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-collection": "^1.1.7",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@stellar/freighter-api": "^6.0.1",
    "@stellar/stellar-sdk": "^14.5.0",
    "@tanstack/react-query": "^5.95.2",
    "@tanstack/react-virtual": "^3.14.2",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.19.1",
    "html2canvas": "^1.4.1",
    "isomorphic-dompurify": "^2.2.0",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.522.0",
    "next": "15.3.4",
    "next-intl": "^4.13.0",
    "next-themes": "^0.4.6",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.72.0",
    "react-joyride": "^3.0.0",
    "recharts": "^3.10.0",
    "rehype-sanitize": "^5.0.0",
    "resend": "^6.9.4",
    "sonner": "^2.0.7",
    "soroban-client": "^0.11.0",
    "tailwind-merge": "^3.3.1",
    "web-push": "^3.6.7",
    "web-vitals": "^5.3.0",
    "workbox-window": "^7.4.1",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@chromatic-com/storybook": "^5.2.1",
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@eslint/eslintrc": "^3",
    "@faker-js/faker": "^10.5.0",
    "@hunty/config": "workspace:*",
    "@playwright/test": "^1.58.2",
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/addon-mcp": "^0.6.0",
    "@storybook/addon-vitest": "^10.4.6",
    "@storybook/nextjs-vite": "^10.4.6",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/serviceworker": "^0.0.197",
    "@types/web-push": "^3.6.4",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.1.1",
    "@vitest/ui": "^4.0.18",
    "cssnano": "^8.0.2",
    "eslint": "^9",
    "eslint-config-next": "15.3.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-storybook": "^10.4.6",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "lint-staged": "15.5.2",
    "node-mocks-http": "^1.12.1",
    "playwright": "^1.61.0",
    "pnpm": "^10.33.0",
    "prettier": "3.5.3",
    "sharp": "^0.35.2",
    "storybook": "^10.4.6",
    "supertest": "^6.3.4",
    "tailwindcss": "^4.0.0",
    "turbo": "^2.10.7",
    "tw-animate-css": "^1.3.4",
    "typescript": "^5",
    "vite": "^8.1.0",
    "vitest": "^4.0.18"
  },
  "pnpm.overrides": {
    "@vitejs/plugin-react": "^6.0.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}

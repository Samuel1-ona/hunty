{
  "name": "hunty",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "description": "Cross-platform scavenger hunt dApp using Next.js, Expo, IPFS, and Stellar/Soroban.",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "type-check": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:mutation": "turbo run test:mutation",
    "e2e": "turbo run e2e",
    "smoke": "turbo run smoke",
    "test:e2e": "pnpm test:e2e --workspace @hunty/web",
    "analyze": "pnpm analyze --workspace @hunty/web",
    "bundle:check": "turbo run bundle:check",
    "perf:budget": "turbo run perf:budget",
    "storybook": "pnpm storybook --workspace @hunty/web",
    "build-storybook": "pnpm build-storybook --workspace @hunty/web",
    "clean": "turbo run clean",
    "prepare": "husky"
  },
  "lint-staged": {
    "apps/mobile/**/*.{js,jsx,ts,tsx,json,md}": [
      "npx prettier --write"
    ],
    "apps/web/**/*.{ts,tsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "packages/**/*.{ts,tsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{js,mjs,cjs}": [
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@testing-library/dom": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "husky": "^9.1.7",
    "lint-staged": "15.5.2",
    "prettier": "3.5.3",
    "react": "19.2.8",
    "turbo": "^2.10.7"
  },
  "pnpm.overrides": {
    "@vitejs/plugin-react": "^6.0.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
